{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gitleaks-before-push.sh", "timeout": 120 },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-deploy-gate.sh", "timeout": 30 }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-deploy-gate.sh", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/mark-stale.sh", "timeout": 15 }
        ]
      }
    ]
  }
}
